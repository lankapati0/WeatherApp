<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/weather_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:clipChildren="false"
    tools:context=".MainActivity">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvLocation"
        android:text="Vadodara"
        android:textColor="@color/weather_primary_text"
        android:textSize="24sp"
        android:layout_marginTop="58dp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvTemperature"
        android:text="--°C"
        android:textColor="@color/weather_primary_text"
        android:textSize="30sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tvTemperature"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Mostly Clear"
        android:id="@+id/tvCondition"
        android:textColor="#C8C5E8"
        android:layout_marginTop="0dp"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvHighLow"
        app:layout_constraintTop_toBottomOf="@+id/tvCondition"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:text="H"
        />
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/weatherArtwork"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvHighLow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="@+id/forecastPanel">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:src="@drawable/house"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="290dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/forecastPanel"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        android:elevation="8dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:background="@drawable/bg_forecast_panel">
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:id="@+id/panelHandle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_panel_handle"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            app:layout_constraintTop_toBottomOf="@id/panelHandle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvWeeklyForecast"
            android:textColor="#D5CFEA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tvHourlyForecast"
            android:text="Hourly Forecast"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:textColor="#B3A9C8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tvWeeklyForecast"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvHourlyForecast"
            app:layout_constraintTop_toBottomOf="@id/panelHandle"
            android:text="Weekly Forecast"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:id="@+id/forecastDivider"
            app:layout_constraintTop_toBottomOf="@id/tvHourlyForecast"
            android:background="#77799A"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/forecastDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/rvHourlyForecast"
            android:overScrollMode="never"

            android:fillViewport="false"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingStart="16dp"
            android:layout_gravity="center_vertical"
            android:clipToPadding="false"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/forecastDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/rvDailyForecast"
            android:overScrollMode="never"
            android:visibility="gone"
            android:fillViewport="false"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingStart="16dp"
            android:layout_gravity="center_vertical"
            android:clipToPadding="false"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>