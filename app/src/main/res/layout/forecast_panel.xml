<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/forecastPanel"
        app:behavior_fitToContents="true"
        app:behavior_halfExpandedRatio="0.5"
        app:behavior_hideable="false"
        app:behavior_draggable="true"
        android:elevation="8dp"
        android:padding="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:background="@drawable/bg_forecast_panel">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:id="@+id/forecastScrollview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:id="@+id/panelHandle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_panel_handle"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rvForecastDaily"
                app:layout_constraintTop_toBottomOf="@id/panelHandle"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvWeeklyForecast"
                    android:textColor="#D5CFEA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/tvHourlyForecast"
                    android:text="Hourly Forecast"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:textColor="#B3A9C8"
                    android:textSize="14sp"
                    android:layout_toEndOf="@+id/tvHourlyForecast"
                    android:layout_marginStart="50dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/tvWeeklyForecast"
                    android:text="Weekly Forecast"/>

            </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:id="@+id/forecastDivider"
            app:layout_constraintTop_toBottomOf="@id/rvForecastDaily"
            android:background="#77799A"/>


        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/forecastDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/rvHourlyForecast"
            android:overScrollMode="never"
            android:fillViewport="false"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:layout_gravity="center_vertical"
            android:clipToPadding="false"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:layout_marginStart="-20dp"
            app:layout_constraintTop_toBottomOf="@id/forecastDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/rvDailyForecast"
            android:overScrollMode="never"
            android:visibility="gone"
            android:fillViewport="false"
            android:paddingBottom="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:paddingStart="16dp"
            android:layout_gravity="center_vertical"
            android:clipToPadding="false"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardElevation="10dp"
            android:id="@+id/cardAQI"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp">
           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:background="@drawable/bg_forecast_cardview">
               <ImageView
                   android:layout_width="20dp"
                   android:layout_height="20dp"
                   android:id="@+id/ivAirQuality"
                   app:tint="@android:color/white"
                   android:layout_marginStart="20dp"
                   android:layout_marginTop="10dp"
                   android:src="@drawable/ic_airquality"/>
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="AIR QUALITY"
                   android:gravity="center"
                   android:textColor="@android:color/white"
                   android:textSize="12sp"
                   android:layout_toEndOf="@+id/ivAirQuality"
                   android:layout_marginStart="10dp"
                   android:layout_marginTop="15dp"/>
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                        android:layout_below="@id/ivAirQuality"
                       android:gravity="center"
                       android:textColor="@android:color/white"
                       android:textSize="14sp"
                       android:id="@+id/tvSampleTextProgress"
                       android:layout_marginStart="20dp"
                       android:layout_marginTop="10dp"/>

               <com.example.weatherapp.CustomViews.GradientProgressBar
                   android:layout_width="match_parent"
                   android:layout_height="10dp"
                   android:layout_below="@+id/tvSampleTextProgress"
                   android:id="@+id/progressAirQuality"
                   android:layout_marginTop="20dp"
                   android:layout_marginStart="10dp"
                   android:layout_marginEnd="10dp"
                   />

               <androidx.constraintlayout.widget.ConstraintLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:layout_marginTop="20dp"
                   android:layout_margin="10dp"
                   android:id="@+id/clViewMore"
                   android:layout_below="@+id/progressAirQuality">
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       app:layout_constraintTop_toTopOf="parent"
                       app:layout_constraintStart_toStartOf="parent"
                       android:textColor="@android:color/white"
                       android:id="@+id/tvDemoProgress"
                       android:text="See more"/>
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="›"
                       app:layout_constraintTop_toTopOf="parent"
                       app:layout_constraintEnd_toEndOf="parent"
                       android:layout_marginEnd="10dp"
                       android:textColor="#B0A8BC"
                       android:textSize="20sp" />
               </androidx.constraintlayout.widget.ConstraintLayout>

           </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/llUVIndexSunrise"
            android:weightSum="2">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:cardElevation="4dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_forecast_cardview"
                        >
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:tint="@android:color/white"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="10dp"
                            android:id="@+id/ic_uvindex"
                            android:src="@drawable/ic_uvindex"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UV INDEX"
                            android:gravity="center"
                            android:id="@+id/tvDemoUVIndex"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:layout_toEndOf="@+id/ic_uvindex"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="15dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30sp"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="20dp"
                            android:layout_below="@id/ic_uvindex"
                            android:textColor="@android:color/white"
                            android:id="@+id/tvUVIndex"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvUVIndexDetail"
                            android:textSize="18sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginStart="20dp"
                            android:textColor="@android:color/white"
                            android:layout_below="@+id/tvUVIndex"/>
                        <com.example.weatherapp.CustomViews.GradientProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/progressUVIndex"
                            android:layout_marginStart="10dp"

                            android:layout_marginBottom="15dp"
                            android:layout_below="@id/tvUVIndexDetail"
                            android:layout_marginTop="5dp"/>
                    </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:cardElevation="4dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_forecast_cardview"
                    >
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:tint="@android:color/white"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:id="@+id/ic_sunrise"
                        android:src="@drawable/ic_sunrise"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunrise"
                        android:gravity="center"
                        android:id="@+id/tvDemoSunrise"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:layout_toEndOf="@+id/ic_sunrise"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="15dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="30sp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="20dp"
                        android:layout_below="@id/ic_sunrise"
                        android:textColor="@android:color/white"
                        android:id="@+id/tvSunriseTime"/>

                    <com.example.weatherapp.CustomViews.SunriseArcView
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_below="@+id/tvSunriseTime"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="5dp"
                        android:id="@+id/sunriseView"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:id="@+id/tvSunsettime"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_below="@id/sunriseView"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Wind and Rainfall -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/llWindRainfall"
            android:weightSum="2">
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:cardElevation="4dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_forecast_cardview"
                    >
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:tint="@android:color/white"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:id="@+id/ic_wind"
                        android:src="@drawable/ic_wind"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WIND"
                        android:gravity="center"
                        android:id="@+id/tvDemoWind"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:layout_toEndOf="@+id/ic_wind"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="15dp"/>

                    <com.example.weatherapp.CustomViews.WindCompassView
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="5dp"
                        android:id="@+id/tvWind"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_below="@+id/tvDemoWind"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:cardElevation="4dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_forecast_cardview"
                    >
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:tint="@android:color/white"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:id="@+id/ic_rainfall"
                        android:src="@drawable/ic_rainfall"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAINFALL"
                        android:gravity="center"
                        android:id="@+id/tvDemoRainfall"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:layout_toEndOf="@+id/ic_rainfall"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="15dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="25sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="20dp"
                        android:layout_below="@id/ic_rainfall"
                        android:textColor="@android:color/white"
                        android:id="@+id/tvRainfall"/>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>


