<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="90dp"
    android:layout_height="180dp"
    android:layout_marginEnd="10dp"
    android:minWidth="88dp"
    android:background="@drawable/bg_hourly_card"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvForecastTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="12 PM"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvForecastIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="🌤️"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/tvForecastTime"/>

    <TextView
        android:id="@+id/tvRainChance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="30%"
        android:textColor="#38DDEB"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvForecastIcon"/>

    <TextView
        android:id="@+id/tvForecastTemperature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="29°"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>